---
import '../styles/style.css';
import SiteHead from '../components/SiteHead.astro';
import logData from '../data/log.json';
import { resolveSiteLink } from '../utils/links';

type LogEntry = {
  date: string;
  category: 'project' | 'event' | 'learning' | 'milestone';
  title: string;
  link?: string;
};

const entries: LogEntry[] = [...logData] as LogEntry[];
entries.sort((a, b) => b.date.localeCompare(a.date));

const years: { year: number; items: typeof entries }[] = [];
for (const entry of entries) {
  const year = new Date(`${entry.date}T00:00:00Z`).getUTCFullYear();
  let group = years.find((item) => item.year === year);
  if (!group) {
    group = { year, items: [] };
    years.push(group);
  }
  group.items.push(entry);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SiteHead title="The Log | n3Xm@R" description="Things I've done. Nothing more, nothing less." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="log-page">
    <main class="log-shell">
      <header class="log-header">
        <a href="/" class="back-link">Back home ←</a>
        <a href="/" class="log-brand">n3Xm@R</a>
      </header>

      <section class="log-intro">
        <p>ACTIVITY ARCHIVE /</p>
        <h1>The Log.</h1>
        <span>Things I've done. Nothing more, nothing less.</span>
      </section>

      <section class="log-history" aria-label="Activity archive">
        {years.map((group) => (
          <section class="log-year" aria-labelledby={`log-year-${group.year}`}>
            <div class="year-header">
              <span class="year-line" aria-hidden="true"></span>
              <h2 id={`log-year-${group.year}`}>{group.year}</h2>
            </div>

            <ol class="log-entries">
              {group.items.map((entry) => {
                const { href, external, valid: safeLink } = resolveSiteLink(entry.link);

                return (
                  <li class="log-entry">
                    <div class="entry-content">
                      <span class="entry-category">{entry.category}</span>
                      <h3>
                        {safeLink ? (
                          <a
                            href={href}
                            target={external ? '_blank' : undefined}
                            rel={external ? 'noopener noreferrer' : undefined}
                          >
                            {entry.title}
                          </a>
                        ) : (
                          entry.title
                        )}
                      </h3>
                    </div>
                    <time datetime={entry.date}>
                      {new Date(`${entry.date}T00:00:00Z`).toLocaleDateString('en-US', {
                        month: 'short',
                        day: '2-digit',
                        timeZone: 'UTC'
                      }).toUpperCase()}
                    </time>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}

        {years.length === 0 && (
          <p class="log-empty">Nothing here yet.</p>
        )}
      </section>
    </main>
  </body>
</html>

<style>
  .log-page {
    min-height: 100vh;
    background: #080808;
  }

  .log-shell {
    width: min(1100px, calc(100% - 36px));
    max-width: 1100px;
    margin: 22px auto;
    padding: 24px 30px 32px;
    border-radius: 20px;
    background: var(--bg);
  }

  .log-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 0 30px;
    border-bottom: 1px solid var(--border);
  }

  .back-link {
    color: var(--muted);
    font-size: 13px;
  }

  .log-brand {
    color: var(--accent);
    font-weight: 700;
    font-size: 19px;
  }

  .log-intro {
    padding: 48px 0 42px;
    text-align: left;
  }

  .log-intro p {
    margin: 0 0 16px;
    color: var(--accent);
    font-size: 13px;
  }

  .log-intro h1 {
    margin: 0 0 14px;
    font-size: clamp(25px, 4vw, 35px);
    line-height: 1.2;
  }

  .log-intro span {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .year-header {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: 16px;
    margin: 0;
  }

  .year-line {
    flex: 1;
    height: 1px;
    background: var(--divider);
  }

  .year-header h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    color: var(--accent);
  }

  .log-entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .log-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 66px;
    align-items: center;
    gap: 26px;
    min-height: 136px;
    border-bottom: 1px solid var(--divider);
  }

  .log-year .log-entry:last-child {
    border-bottom: 0;
  }

  .entry-content {
    min-width: 0;
    padding: 20px 0;
    text-align: left;
  }

  .entry-category {
    display: block;
    margin-bottom: 10px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .entry-content h3 {
    margin: 0;
    color: var(--text);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .entry-content a {
    color: inherit;
  }

  .entry-content a:hover,
  .entry-content a:focus-visible {
    color: var(--accent);
  }

  .log-entry time {
    color: var(--muted);
    font-size: 12px;
    text-align: right;
    white-space: nowrap;
  }

  .log-empty {
    padding: 30px 0;
    color: var(--muted);
    text-align: left;
  }

  @media (max-width: 600px) {
    .log-shell {
      width: calc(100% - 20px);
      margin: 10px auto;
      padding: 18px 18px 28px;
      border-radius: 14px;
    }

    .log-header { padding-bottom: 22px; }
    .log-intro { padding: 36px 0 35px; }
    .log-intro p { font-size: 11px; }
    .log-intro span { font-size: 12px; }
    .year-header h2 { font-size: 18px; }

    .log-entry {
      grid-template-columns: minmax(0, 1fr) 54px;
      gap: 14px;
      min-height: 106px;
    }

    .entry-content h3 { font-size: 14px; }
    .entry-category { font-size: 10px; }
    .log-entry time { font-size: 10px; }
  }
</style>
