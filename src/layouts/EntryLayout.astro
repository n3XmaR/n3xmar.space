---
import '../styles/style.css';
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title: string;
  description?: string;
  category: string;
  date?: string | Date;
  meta?: string;
  backHref: string;
  backText: string;
  type?: 'article' | 'project';
}
const { title, description, category, date, meta, backHref, backText, type = 'article' } = Astro.props;
const dateLabel = date
  ? new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SiteHead title={`${title} | n3Xm@R`} description={description ?? title} type={type === 'article' ? 'article' : 'website'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class:list={['entry-page', type === 'project' && 'entry-project']} id="top">
      <nav class="entry-nav" aria-label="Page navigation">
        <a href={backHref} id="back-link">← {backText}</a>
        <span class="entry-label">/ N3XMAR.SPACE</span>
      </nav>
      <header class="entry-header">
        <p class="entry-category">{category}</p>
        <h1>{title}</h1>
        {description && <p class="entry-description">{description}</p>}
        {(dateLabel || meta) && <p class="entry-meta">{dateLabel}{dateLabel && meta && ' · '}{meta}</p>}
        <div class="entry-accent" aria-hidden="true"></div>
      </header>
      <article class="entry-content"><slot /></article>
      <footer class="entry-footer"><span>END OF ENTRY_</span><a href="#top">↑ BACK TO TOP</a></footer>
    </main>
    <script>
      const backLink = document.querySelector<HTMLAnchorElement>('#back-link');
      if (backLink && document.referrer) {
        try {
          const prev = new URL(document.referrer);
          if (prev.origin === location.origin && prev.pathname === '/') {
            backLink.href = '/';
            backLink.textContent = '← BACK TO HOME';
          }
        } catch { /* Keep default back link. */ }
      }
    </script>
  </body>
</html>

<style is:global>
  .entry-page { max-width:920px; margin:0 auto; padding:34px 28px 100px; }
  .entry-project { max-width:1060px; }
  .entry-nav { display:flex; justify-content:space-between; align-items:center;
    gap:16px; padding-bottom:20px; border-bottom:1px solid var(--divider); }
  .entry-nav a { color:var(--muted); font-size:12px; }
  .entry-nav a:hover,.entry-footer a:hover { color:var(--accent); }
  .entry-label,.entry-category,.entry-meta,.entry-footer {
    font-family:ui-monospace,SFMono-Regular,Consolas,monospace; letter-spacing:.06em; }
  .entry-label { color:var(--side-muted); font-size:10px; }
  .entry-header { display:block; margin:68px 0 45px; }
  .entry-category { margin:0 0 16px; color:var(--accent); font-size:12px;
    text-transform:uppercase; letter-spacing:.12em; }
  .entry-header h1 { color:var(--text); margin:0 0 18px; font-weight:700;
    font-size:clamp(32px,5.3vw,48px); line-height:1.15; letter-spacing:-.035em; }
  .entry-description { max-width:700px; margin:0 0 14px; color:#c6c0b7;
    font-size:16px; line-height:1.75; }
  .entry-meta { color:var(--muted); font-size:12px; margin:0 0 24px; }
  .entry-accent { height:2px; width:52px; margin-top:24px; background:var(--accent); }
  .entry-content { max-width:760px; color:#d4cec4; font-size:16px;
    line-height:1.85; overflow-wrap:break-word; }
  .entry-content > :first-child { margin-top:0; }
  .entry-content p { margin:0 0 23px; }
  .entry-content h2,.entry-content h3 { color:var(--text); line-height:1.3; }
  .entry-content h2 { font-size:25px; margin:48px 0 18px; }
  .entry-content h3 { font-size:20px; margin:35px 0 16px; }
  .entry-content ul,.entry-content ol { padding-left:24px; margin:0 0 26px; }
  .entry-content li { margin-bottom:8px; padding-left:3px; }
  .entry-content li::marker { color:var(--accent); }
  .entry-content strong { color:var(--text); }
  .entry-content a { color:var(--accent); text-decoration:underline; text-underline-offset:3px; }
  .entry-content blockquote { margin:34px 0; border-left:2px solid var(--accent);
    padding:12px 0 12px 20px; color:var(--accent); font-style:italic; }
  .entry-content blockquote p { margin:0; }
  .entry-content code { background:var(--surface); font-size:.89em; padding:3px 6px; border-radius:4px; }
  .entry-content pre { overflow-x:auto; padding:18px; border:1px solid var(--divider);
    background:var(--surface); border-radius:8px; }
  .entry-content pre code { background:transparent; padding:0; }
  .entry-content img { display:block; width:100%; max-width:100%; height:auto;
    margin:14px 0; border:1px solid #332f2a; border-radius:9px; }
  .entry-project .entry-content { max-width:980px; }
  .entry-project .entry-content p:not(:has(> img)),
  .entry-project .entry-content ul,.entry-project .entry-content ol { max-width:780px; }
  .entry-footer { max-width:760px; margin-top:78px; padding-top:20px;
    border-top:1px solid var(--divider); display:flex; justify-content:space-between;
    gap:16px; color:var(--muted); font-size:11px; }
  .entry-footer a { color:var(--accent); }
  @media (max-width:600px) {
    .entry-page { padding:22px 20px 64px; }
    .entry-header { margin:46px 0 32px; }
    .entry-header h1 { font-size:clamp(30px,8vw,39px); }
    .entry-description { font-size:15px; }
    .entry-content { font-size:15px; line-height:1.8; }
    .entry-content h2 { font-size:23px; margin-top:38px; }
    .entry-label { display:none; }
    .entry-footer { margin-top:56px; }
  }
</style>